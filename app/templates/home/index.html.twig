{# home.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<section class="bg-gradient-to-r from-blue-500 to-indigo-600 text-white py-20">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Bienvenue sur TetedeLivre</h1>
        <p class="text-lg md:text-xl mb-8">Connectez-vous avec vos amis, partagez vos moments et découvrez de nouvelles Tete.</p>
        <a href="/register" class="inline-block bg-white text-blue-600 font-semibold px-6 py-3 rounded-lg shadow hover:bg-gray-100 transition">
            Rejoignez-nous
        </a>
    </div>
</section>

<section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-10 text-center">
        <div class="bg-white p-6 rounded-xl shadow hover:shadow-lg transition">
            <h3 class="text-xl font-semibold mb-3">Connectez-vous facilement</h3>
            <p class="text-gray-600">Ajoutez vos amis et restez en contact avec eux partout dans le monde.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow hover:shadow-lg transition">
            <h3 class="text-xl font-semibold mb-3">Partagez vos moments</h3>
            <p class="text-gray-600">Publiez des photos, des vidéos et vos idées en toute simplicité.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow hover:shadow-lg transition">
            <h3 class="text-xl font-semibold mb-3">Découvrez de nouvelles personnes</h3>
            <p class="text-gray-600">Explorez de nouveaux profils et élargissez votre réseau social.</p>
        </div>
    </div>
</section>

<section class="py-16 bg-blue-600 text-white">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Prêt à rejoindre la communauté ?</h2>
        <p class="mb-8">Créez votre compte gratuitement et commencez à partager vos moments dès aujourd'hui.</p>
        <a href="/register" class="inline-block bg-white text-blue-600 font-semibold px-6 py-3 rounded-lg shadow hover:bg-gray-100 transition">
            S'inscrire maintenant
        </a>
    </div>
</section>
{% endblock %}
